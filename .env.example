# RenoMeta Connect — environment variable reference
# -------------------------------------------------
# Copy to `.env` for local development and fill in real values.
# `.env` is git-ignored; this file is the checked-in, sanitized reference.
#
# SCOPE column meaning (how it should be scoped in the Netlify dashboard):
#   [build]     - needed only during `vite build`; do NOT expose to Functions
#   [function]  - needed by netlify/functions/* at runtime
#   [both]      - needed at build time AND by Functions
#   [auto]      - injected automatically by Netlify; never set manually
#   [local]     - convenience for local dev only; not required in Netlify
#
# REQUIRED = app feature breaks without it. OPTIONAL = feature degrades gracefully.


# ============================================================
# Supabase                                          [REQUIRED]
# ============================================================
# Server-only service-role credentials. NEVER prefix with VITE_ and never
# expose to the browser bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co               # [function] REQUIRED
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt             # [function] REQUIRED - secret

# Browser client. Baked into the JS bundle at build time (public by design).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co          # [build] REQUIRED
VITE_SUPABASE_ANON_KEY=your-anon-jwt                        # [build] REQUIRED


# ============================================================
# AI (Anthropic / Claude)                           [REQUIRED]
# ============================================================
# Used by run-agent, run-tool, ai-tool-run, ai-draft-reply, execute-workflow,
# lib/post-call-automation.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx                           # [function] REQUIRED - secret


# ============================================================
# Encryption                                        [REQUIRED]
# ============================================================
# AES-256-GCM key for OAuth / Meta token decryption (gcal token in vapi-webhook,
# meta-oauth-callback, meta-create-ad-campaign, send-inbox-message). Also the
# fallback signer for META_OAUTH_STATE_SECRET.
ENCRYPTION_KEY=base64-32-byte-key                           # [function] REQUIRED - secret


# ============================================================
# Voice AI (Vapi)                                   [REQUIRED]
# ============================================================
VAPI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx           # [function] REQUIRED - secret
# Verifies inbound Vapi webhook signatures. If unset, vapi-webhook.ts SKIPS
# signature verification (logs a warning). Set in production.
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret                # [function] OPTIONAL (recommended) - secret

VITE_VAPI_PUBLIC_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # [build] REQUIRED (browser test call)
# Override for the Vapi webhook server URL (e.g. ngrok tunnel) during local dev.
VITE_VAPI_SERVER_URL=https://your-tunnel.example/.netlify/functions/vapi-webhook  # [build] OPTIONAL / [local]


# ============================================================
# Twilio — SMS + missed-call text-back              [REQUIRED for SMS]
# ============================================================
# Consumed by portal-action, execute-workflow (missed_call workflow),
# run-agent, run-tool.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # [function] REQUIRED - secret
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx           # [function] REQUIRED - secret
# The "From" number. NOTE: code expects exactly this name (not CALLER_ID /
# TWILIO_SMS_NUMBER). Must be present in Functions scope for missed-call SMS.
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX                            # [function] REQUIRED
# Owner's number for "new portal message" SMS alerts (portal-action).
NOTIFY_PHONE_NUMBER=+1XXXXXXXXXX                            # [function] OPTIONAL


# ============================================================
# Email (SMTP via Gmail)                            [REQUIRED for email]
# ============================================================
# Consumed by invite-member, portal-invite, send-email, execute-workflow.
# Host/port are hard-coded to smtp.gmail.com:587 in code.
SMTP_USER=support@example.com                               # [function] REQUIRED
SMTP_PASSWORD=your-gmail-app-password                       # [function] REQUIRED - secret
# DEPRECATED alias for SMTP_PASSWORD. send-email.ts now reads SMTP_PASSWORD first
# and falls back to SMTP_PASS. Remove once Netlify is updated to SMTP_PASSWORD.
# SMTP_PASS=your-gmail-app-password                         # [function] LEGACY - remove after cutover


# ============================================================
# Payments (Stripe)                                 [REQUIRED for portal payments]
# ============================================================
# portal-action create_payment. If unset, the portal records a follow-up note
# instead of opening Stripe Checkout.
STRIPE_SECRET_KEY=sk_live_xxxxxxxx                          # [function] REQUIRED (portal pay) - secret


# ============================================================
# Meta — WhatsApp / Messenger / Instagram / Lead Ads  [REQUIRED for Meta]
# ============================================================
META_APP_ID=xxxxxxxxxxxxxxx                                 # [function] REQUIRED
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx            # [function] REQUIRED - secret
# Webhook handshake token (meta-webhook GET verify).
META_VERIFY_TOKEN=your-verify-token                         # [function] REQUIRED
# HMAC secret for the OAuth `state` param. If unset, falls back to ENCRYPTION_KEY.
META_OAUTH_STATE_SECRET=your-state-secret                   # [function] OPTIONAL - secret
#
# NOT USED by code (kept only for reference / dashboards):
#   META_OAUTH_SCOPES      - scopes are hard-coded per product in meta-oauth-start.ts
#   VITE_META_REDIRECT_URI - redirect_uri is derived from Netlify `URL` at runtime

# WhatsApp appointment-confirmation template (send-inbox-message). Both have
# in-code defaults, so only set to override.
WHATSAPP_TEMPLATE_NAME=renometa_appointment_confirmed_      # [function] OPTIONAL
WHATSAPP_TEMPLATE_LANG=en_US                                # [function] OPTIONAL


# ============================================================
# Make.com webhooks                                 [OPTIONAL]
# ============================================================
# vapi-webhook forwards call-ended / tool-call events. No-op if unset.
MAKE_CALL_ENDED_WEBHOOK=https://hook.make.com/xxxxxxxx      # [function] OPTIONAL
MAKE_TOOL_CALL_WEBHOOK=https://hook.make.com/xxxxxxxx       # [function] OPTIONAL


# ============================================================
# Google Places (address autocomplete)             [OPTIONAL]
# ============================================================
VITE_GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXX                   # [build] OPTIONAL


# ============================================================
# Injected automatically by Netlify — DO NOT SET    [auto]
# ============================================================
# URL   - canonical deploy URL. Used by meta-oauth-start / meta-oauth-callback to
#         build redirect_uri, and by vapi-webhook to call execute-workflow.
#         Netlify sets this per-deploy; setting it manually breaks deploy previews.


# ============================================================
# NOT referenced anywhere in this repo on `main`
# ------------------------------------------------------------
# Safe to remove from Netlify *Functions* scope now (keep in Builds only if a
# build step ever needs them; keep the value somewhere safe if the integration
# is still planned). See docs/environment-variable-audit.md for the full rationale.
# ============================================================
# URL / base-url duplicates (URL is derived; these have no consumer):
#   APP_BASE_URL  APP_LOCAL_URL
#
# Email duplicates / unused senders:
#   SMTP_HOST  SMTP_PORT  SMTP_FROM
#   GMAIL_USER  GMAIL_APP_PASSWORD  GMAIL_FROM  GMAIL_SMTP_HOST  GMAIL_SMTP_PORT  GMAIL_SMTP_SECURE
#   EMAIL_SENDER_API_KEY  EMAIL_SENDER_USER
#   RESEND_API_KEY
#   MAILTRAP_*  NETLIFY_EMAILS_*
#
# Secrets with no consumer:
#   JWT_SECRET  BRIDGE_SHARED_SECRET  REG_SECRET
#
# Twilio extras not read by code (code uses TWILIO_PHONE_NUMBER only):
#   TWILIO_MESSAGING_SERVICE_SID  CALLER_ID
#   TWILIO_WHATSAPP_ENABLED  TWILIO_WHATSAPP_NUMBER  TWILIO_SMS_ENABLED  TWILIO_SMS_NUMBER
#   MISSED_CALL_ENABLED  MISSED_CALL_MESSAGE
#
# OAuth for integrations not yet built on `main` (reserved / in development —
# no gmail-sync / gcal-sync / google-ads / slack / microsoft function exists here):
#   GOOGLE_OAUTH_CLIENT_ID  GOOGLE_OAUTH_CLIENT_SECRET  GOOGLE_REDIRECT_BASE_URL
#   GOOGLE_GMAIL_SCOPES  GOOGLE_CAL_SCOPES  GOOGLE_DRIVE_SCOPES  GOOGLE_GMB_SCOPES
#   GOOGLE_ADS_SCOPES  GOOGLE_CONTACTS_SCOPES  GOOGLE_ADS_* (client id/secret/developer token/etc.)
#   MS_OAUTH_CLIENT_ID  MS_OAUTH_CLIENT_SECRET  MS_OAUTH_TENANT_ID  MS_OAUTH_SCOPES
#   SLACK_OAUTH_CLIENT_ID  SLACK_OAUTH_CLIENT_SECRET  SLACK_SIGNING_SECRET
#   SLACK_OAUTH_SCOPES  SLACK_REDIRECT_URI
#   DOCUSIGN_*  TRIGGER_*  RENOMETA_AWS_*
